# per-run training logs from the multi-seed sweeps; the JSON/pt captures are the evidence
results/**/train.log
results/multiseed*/**/metrics.json
results/knob_selection_v2/**/metrics.json

# Dev runs keep their small evidence (benchmark/ablation/diagnostics/predictions
# and the feedback OOF tensors); the bulky per-epoch and per-edge dumps a fusion
# run writes stay local. `metrics_slim.json` is the committed stand-in for
# `metrics.json`.
results/dev/**/training_history.json
results/dev/**/metrics.json
results/dev/**/model.pt
results/dev/**/scalers.pt
results/dev/**/edge_embeddings.pt
results/dev/**/gate_weights.pt
results/dev/**/feature_attention_weights.pt

# results/dev keeps only small JSON evidence in git: benchmark/ablation/
# mechanism_diagnostics/selected_feedback_config and the hand-written summaries.
# Tensors, per-epoch dumps and logs stay local.
results/dev/**/*.pt
results/dev/**/*.npy
results/dev/**/run.log
results/dev/**/*.log
results/knob_selection_head/**/metrics.json
